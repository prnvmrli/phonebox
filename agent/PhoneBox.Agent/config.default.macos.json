{
  // PhoneBox settings. Easiest to edit at http://127.0.0.1:8765.
  // Manual edits are picked up on the next request; no restart needed.

  // Only use the phone with this serial number (null = every connected Android device)
  "deviceSerial": null,
  // Path to adb.exe (null = searched in PATH, the Android SDK and winget locations)
  "adbPath": null,

  // Weather location (Open-Meteo, no API key required)
  "weather": { "city": "Tallinn", "lat": 59.437, "lon": 24.745 },

  // Night mode: between these times the screen dims and only the clock stays. Tap to wake it for 30 s.
  "night": { "enabled": true, "start": "00:30", "end": "07:30", "brightness": 0.02 },

  // Clock seconds, return to the first page after N idle seconds (0 = never), vibrate on session events,
  // switch pages with the phone's volume keys
  "display": { "showSeconds": true, "idleReturnSec": 90, "vibrate": true, "volumeKeys": true },

  // Pages in the order they appear on the phone. Each page is a 12 x 6 grid of widgets; the settings page has a
  // visual editor. { "template": "<id>" } creates a page from templates.json (home, ai, work, system, procs, deck,
  // music, clock, focus, world, dashboard, devops, feeds, ambient, markets, daily, status, calm) and is replaced by
  // its widgets on the first save.
  "pages": [
    { "template": "home" },
    { "template": "ai" },
    { "template": "work" },
    { "template": "system" },
    { "template": "procs" },
    { "template": "deck" },
    { "template": "music" },
    { "template": "focus", "enabled": false },
    { "template": "world", "enabled": false }
  ],

  // Shortcut keys. The phone only sends the "id"; commands live in this file only.
  // cmd: a program, a URL, or builtin:lock | builtin:monitor-off | builtin:mute
  "shortcuts": [
    { "id": "terminal", "label": "Terminal", "icon": "⌨️", "color": "#4b5563", "cmd": "open", "args": "-a Terminal ~/" },
    { "id": "files", "label": "Finder", "icon": "📁", "color": "#e5b84b", "cmd": "open", "args": "~" },
    { "id": "vscode", "label": "VS Code", "icon": "📝", "color": "#2f80ed", "cmd": "open", "args": "-a \"Visual Studio Code\"" },
    { "id": "browser", "label": "Browser", "icon": "🌐", "color": "#0ea5e9", "cmd": "https://github.com" },
    { "id": "ytmusic", "label": "YouTube Music", "icon": "🎵", "color": "#ff0000", "cmd": "https://music.youtube.com" },
    { "id": "calc", "label": "Calculator", "icon": "🧮", "color": "#64748b", "cmd": "open", "args": "-a Calculator" },
    { "id": "settings", "label": "Settings", "icon": "⚙️", "color": "#94a3b8", "cmd": "open", "args": "-a \"System Settings\"" },
    { "id": "monitor", "label": "Activity Monitor", "icon": "📊", "color": "#22c55e", "cmd": "open", "args": "-a \"Activity Monitor\"" },
    { "id": "mute", "label": "Mute", "icon": "🔇", "color": "#f59e0b", "cmd": "builtin:mute" },
    // Peekaboo: one tap turns the display off (the Mac keeps running), the next turns it back on
    { "id": "peekaboo", "label": "Peekaboo", "icon": "🙈", "color": "#6366f1", "cmd": "builtin:monitor-off", "offCmd": "caffeinate", "offArgs": "-u -t 2", "toggle": true },
    { "id": "lock", "label": "Lock", "icon": "🔒", "color": "#ef4444", "cmd": "builtin:lock" }
  ]
}
